# Keep this file at /etc/mlflow/team-object-store.env on the Team VM only.
# This credential has access to mlflow-artifacts, never to dvc.
MLFLOW_S3_ENDPOINT_URL=https://storage-203-0-113-10.sslip.io
AWS_ACCESS_KEY_ID=replace-with-mlflow-artifact-access-key
AWS_SECRET_ACCESS_KEY=replace-with-mlflow-artifact-secret
AWS_DEFAULT_REGION=us-east-1
